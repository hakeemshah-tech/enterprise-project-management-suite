# =============================================================================
# Enterprise Project Management Suite (EPMS) - Environment Template
# =============================================================================
# Copy this file to `.env` and replace every CHANGE_ME value before running.
# `.env` is git-ignored and must never be committed.
#
# NOTE: Under Docker Compose, DATABASE_URL and REDIS_HOST are overridden to use
# the Compose service names (postgres, redis) instead of localhost.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=epms
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=epms

DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://epms:CHANGE_ME_DB_PASSWORD@localhost:5432/epms"

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# 'development' for local dev, 'production' for Docker Compose / deployed envs
NODE_ENV=development

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Generate real values, never reuse the placeholders below:
#   openssl rand -base64 32   (JWT secrets)
#   openssl rand -hex 32      (encryption key)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encrypts sensitive at-rest data (stored mail credentials, integration tokens)
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# -----------------------------------------------------------------------------
# Redis (Bull queue backend)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Outbound Mail
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.internal.company.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@epms.internal
EMAIL_DOMAIN="epms.internal"

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
# Local dev: frontend on 3001, backend on 3000. Docker Compose: both on 3000.
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN="http://localhost:3001"
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# Queue Tuning
# -----------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=5
JOB_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Object Storage (optional, leave blank to use local disk)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Container Registry (build/deploy tooling)
# -----------------------------------------------------------------------------
INTERNAL_REGISTRY=registry.internal.company.com
IMAGE_NAME=pm-app
